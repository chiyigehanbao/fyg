# 本地 Ollama；默认值已可直接使用，无需复制本文件。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_KEEP_ALIVE=15m

# Web/局域网/生产前端允许访问 API 的来源，多个来源用英文逗号分隔。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 后端可选托管前端生产构建目录；存在 index.html 时，非 /api 路由会回退到 React。
FRONTEND_DIST_DIR=../frontend/dist

# 数据库默认使用 backend/data/app.db。
# 如需切换到本机 PostgreSQL，请创建数据库后启用下面这一行。
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ai_cocreator
